{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://snipshare-backend-kbh1.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://snipshare-backend-kbh1.onrender.com/auth/:path*"
    },
    {
      "source": "/users/:path*",
      "destination": "https://snipshare-backend-kbh1.onrender.com/users/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://snipshare-backend-kbh1.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
